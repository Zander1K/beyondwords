# Copy to .env and fill in. Never commit .env.

# App display name. Change here to rename the app (CLAUDE.md: single APP_NAME constant).
APP_NAME="Beyond Words"

# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Async SQLAlchemy URL for PostgreSQL (asyncpg driver).
# Local (api on host, db in docker): postgresql+asyncpg://reading:reading@127.0.0.1:5432/reading_companion
# Inside docker compose the api service overrides the host to "postgres".
# Hosted Postgres (Aiven etc.): a plain postgresql://...?sslmode=require URL also works; the app
# converts it for asyncpg. On Aiven Runtime it is injected for you (docs/deploy-aiven.md).
DATABASE_URL=postgresql+asyncpg://reading:reading@127.0.0.1:5432/reading_companion

# Which provider brain/llm.py routes model calls to: nemotron (Verda; NVIDIA Build fallback if
# NVIDIA_BUILD_API_KEY is set) or nvidia_build (NVIDIA Build only).
LLM_PROVIDER=nemotron

# OpenAI-compatible base URL of the vLLM server running Nemotron on Verda (Junction 2026 hosted endpoint).
NEMOTRON_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
# Verda inference key (starts with dc_). Ask Matthew; never commit it.
NEMOTRON_API_KEY=
# Model id served at NEMOTRON_BASE_URL (see GET $NEMOTRON_BASE_URL/models).
NEMOTRON_MODEL=nemotron-3.5-super-vl
# Seconds to wait for a Nemotron response. Reasoning output makes long answers slow.
NEMOTRON_TIMEOUT_S=60

# NVIDIA Build API key (fallback brain, ~40 req/min/key free tier).
NVIDIA_BUILD_API_KEY=

# Optional brain tuning (defaults in apps/api/app/brain/settings.py), e.g.:
# BRAIN_ASK_TIMEOUT_S=8
# BRAIN_PAGE_REASONING=false
# BRAIN_NVIDIA_BUILD_MODEL=nvidia/nemotron-3.5-super-vl   # OPEN QUESTION: exact id

# Google Gemini API key (text conversation behind POST /ask + image generation).
GEMINI_API_KEY=
# Gemini model for the text conversation (Ask Out Loud, Talk About It). Voice in and out stays on
# the phone (speech-to-text, text-to-speech). See docs/gemini.md.
GEMINI_CHAT_MODEL=gemini-4-hydrogen
# Gemini image model for word illustrations. Use gemini-nano-banana-2.1 for higher quality.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Google Books API key for barcode/ISBN lookups (console.cloud.google.com, enable "Books API",
# restrict the key to it). Optional: works without a key at a lower quota; Open Library is the fallback.
GOOGLE_BOOKS_API_KEY=

# --- Local run: fixed ports (make local runs the api and the web app together) ---
# FastAPI server (uvicorn) on the host.
API_PORT=38417
# Web app dev server (Vite). The browser calls the API at /api on this port; Vite forwards it to
# http://localhost:$API_PORT (same-origin, so no CORS and it also works from a phone).
WEB_PORT=41263

# Browser origins allowed to call the API (CORS) and open the /live WebSocket. Comma-separated.
# Add your HTTPS tunnel URL here when testing the web app on a phone.
CORS_ORIGINS=http://localhost:41263,http://127.0.0.1:41263

# --- docker-compose only: PostgreSQL container bootstrap (local dev credentials) ---
POSTGRES_DB=reading_companion
POSTGRES_USER=reading
POSTGRES_PASSWORD=reading
