# Copy to .env and fill in. Never commit .env.

# App display name. Change here to rename the app (CLAUDE.md: single APP_NAME constant).
APP_NAME="Beyond Words"

# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Async SQLAlchemy URL for MariaDB (aiomysql driver).
# Local (api on host, db in docker): mysql+aiomysql://reading:reading@127.0.0.1:3306/reading_companion
# Inside docker compose the api service overrides the host to "mariadb".
DATABASE_URL=mysql+aiomysql://reading:reading@127.0.0.1:3306/reading_companion

# Which provider brain/llm.py routes model calls to. OPEN QUESTION: final value set (nemotron | nvidia_build | gemini | muse_spark?).
LLM_PROVIDER=nemotron

# OpenAI-compatible base URL of the vLLM server running Nemotron on Verda (Junction 2026 hosted endpoint).
NEMOTRON_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
# Verda inference key (starts with dc_). Ask Matthew; never commit it.
NEMOTRON_API_KEY=
# Model id served at NEMOTRON_BASE_URL (see GET $NEMOTRON_BASE_URL/models).
NEMOTRON_MODEL=nemotron-3.5-super-vl
# Seconds to wait for a Nemotron response. Reasoning output makes long answers slow.
NEMOTRON_TIMEOUT_S=60

# NVIDIA Build API key (fallback brain, ~40 req/min/key free tier).
NVIDIA_BUILD_API_KEY=

# Google Gemini API key (Gemini Live voice + image generation).
GEMINI_API_KEY=

# Browser origins allowed to call the API (CORS) and open the /live WebSocket. Comma-separated.
# Add your HTTPS tunnel URL here when testing the web app on a phone.
CORS_ORIGINS=http://localhost:5173

# --- Web app (apps/web) ---
# Only VITE_* vars reach the browser bundle, and they are PUBLIC. Never put a key in a VITE_ var.
# Base URL of this API as seen from the browser. Leave unset: the app then calls /api, which the
# Vite dev server forwards to FastAPI (works on localhost and from phones via `make web-lan`).
# VITE_API_BASE_URL=
# Where the dev server forwards /api (default http://localhost:8000).
# API_PROXY_TARGET=http://localhost:8000

# --- docker-compose only: MariaDB container bootstrap (local dev credentials) ---
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=reading_companion
MARIADB_USER=reading
MARIADB_PASSWORD=reading
